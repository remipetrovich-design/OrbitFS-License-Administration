# ORBITFS CUSTOM LICENSE MANAGER — PRODUCTION ENVIRONMENT
# License Master is the TOP technical authority.
# Managed API keys are created, scoped, rotated and revoked here.
# Downstream systems receive only the specific managed key they need.
# Never commit real secrets.

# ---------------------------------------------------------------------------
# DATABASE — shared Supabase PostgreSQL database
# ---------------------------------------------------------------------------
# Use the same Supabase project/database used by the License Master deployment.
# The application accepts a direct Supabase DB URL and automatically converts
# db.<project-ref>.supabase.co to the Supabase session pooler when possible.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_SSL=true
SUPABASE_POOLER_HOST=aws-0-ap-southeast-2.pooler.supabase.com

# ---------------------------------------------------------------------------
# LICENSE MASTER MACHINE-KEY FALLBACKS
# ---------------------------------------------------------------------------
# Optional. Managed integration keys created in License Master are preferred.
# MASTER_API_TOKEN stays inside License Master and is NEVER copied downstream.
MASTER_API_TOKEN=replace-with-license-master-master-fallback
BILLING_API_TOKEN=replace-with-billing-managed-key-fallback
DEPLOYER_API_TOKEN=replace-with-deployer-managed-key-fallback
ADMIN_API_TOKEN=replace-with-admin-managed-key-fallback

# GitHub credential used by License Master to validate and download private
# OrbitFS release assets. Keep the same credential used for the release path
# where practical. It must have read access to Dev-panel and V1-vercel-engine.
ORBITFS_RELEASE_DISPATCH_TOKEN=replace-with-stable-orbitfs-github-token

# Optional legacy/fallback aliases. New installs should use
# ORBITFS_RELEASE_DISPATCH_TOKEN above.
GITHUB_RELEASE_TOKEN=
GITHUB_TOKEN=

# Legacy only. New integrations use managed API keys.
INTEGRATION_API_TOKEN=replace-with-legacy-integration-token

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-long-bootstrap-password

# ---------------------------------------------------------------------------
# CANONICAL PUBLIC HOSTS
# ---------------------------------------------------------------------------
# Admin UI:
#   https://panel.incendiarynetworks.cc
# External API / versioned integration API base:
#   https://incendiarynetworks.cc/api/v1
# Public installed-product license validation API:
#   https://incendiarynetworks.cc/api/v1/license

# ---------------------------------------------------------------------------
# MANAGED INTEGRATION MAP
# ---------------------------------------------------------------------------
# Create/scoped/rotate these in License Master, then copy ONLY the generated
# integration key to its destination secret store:
#
# Developer Page:
#   ORBITFS_RELEASE_DISPATCH_TOKEN = GitHub Actions dispatch credential
#
# V1 Base workflow:
#   LICENSE_MASTER_API_TOKEN = managed License Master key with releases.write
#
# V1 Engine workflow:
#   LICENSE_MASTER_API_TOKEN = managed License Master key with releases.write
#
# V2 Billing Store:
#   BILLING_API_TOKEN  = billing/licensing/release integration key
#   DEPLOYER_API_TOKEN = deployment/update integration key
#
# Separate scoped keys are preferred. A single managed key may only be reused
# where its License Master scopes explicitly cover both operations.
#
# GitHub/Vercel deployment credentials such as VERCEL_TOKEN are NOT License
# Master API keys and remain in the appropriate GitHub/Vercel secret store.
